  case"tech":S.tech=v;save();render();break;
  case"showDone":S.showDone=!S.showDone;save();render();break;
  case"cal":{if(v==="0"){const t=new Date();S.calY=t.getFullYear();S.calM=t.getMonth();S.calD=t.getDate()}else{const d=new Date(S.calY,S.calM+Number(v),1);S.calY=d.getFullYear();S.calM=d.getMonth();S.calD=1}save();render();break}
  case"calD":S.calD=Number(v);save();render();break;
  case"llSite":S.llSite=v;save();render();break;
  case"llKpi":S.llKpi=S.llKpi===v?"all":v;save();render();break;
  case"llCat":{const i=S.llCat.indexOf(v);i>=0?S.llCat.splice(i,1):S.llCat.push(v);save();render();break}
  case"llClear":S.llCat=[];S.llKpi="all";save();render();break;
  case"llNext":{const j=job(id);snap(j);j.ll.status=Math.min(3,j.ll.status+1);save();render();toast(`${j.id}: ${LL_STEPS[j.ll.status]}`,true);break}
  case"chase":{const j=job(id);snap(j);j.ll.chases.push(Date.now());save();render();toast(`Chase logged with ${site(j.site).agent}`,true);break}
  case"docCat":S.docCat=v;save();render();break;
  case"docSite":S.docSite=v;save();render();break;
  case"doc":sheetDoc(v);break;
  case"role":sheetRole(false);break;
  case"reset":sheetRole(true);break;
  case"resetYes":{const keep={role:S.role};try{localStorage.removeItem(KEY)}catch(err){}load();S.role=keep.role;save();closeSheet();render();toast("Sample data reset");break}
  case"setRole":S.role=v;save();render();sheetRole(false);break;
 }
});
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!sheet.hidden)closeSheet()});

/* ---------- Render ---------- */
const VIEWS={helpdesk:{l:"Helpdesk",i:"headset",f:vHelpdesk},planned:{l:"Planned",i:"calendar",f:vPlanned},technicians:{l:"Technicians",i:"wrench",f:vTech},landlord:{l:"Landlord",i:"key",f:vLandlord},documents:{l:"Documents",i:"doc",f:vDocs}};
const app=document.getElementById("app"), tabs=document.getElementById("tabs"), roleBtn=document.getElementById("rolebtn"), ind=document.getElementById("tabind");
let prevBadge={};
function placeInd(){
 const a=tabs.querySelector('[aria-current="page"]'); if(!a)return;
 ind.style.width=a.offsetWidth+"px"; ind.style.transform=`translateX(${a.offsetLeft+tabs.offsetLeft}px)`;
 if(!ind.classList.contains("ready")){ind.classList.add("ready");requestAnimationFrame(()=>requestAnimationFrame(()=>ind.classList.add("anim")))}
}
function cur(){const h=location.hash.slice(1);return VIEWS[h]?h:"helpdesk"}
function render(){
 const v=cur();
 const td=new Date();
 const badge={planned:ppmFor(td.getFullYear(),td.getMonth()).filter(e=>e.date.getDate()===td.getDate()).length,helpdesk:S.jobs.filter(j=>j.stage==="new").length,landlord:S.jobs.filter(j=>j.ll&&j.ll.status<3).length,technicians:S.jobs.filter(j=>j.tech===S.tech&&j.stage!=="complete").length};
 tabs.innerHTML=Object.entries(VIEWS).map(([k,x])=>`<button class="tab" data-act="nav" data-v="${k}" ${k===v?'aria-current="page"':""}><span class="tic">${ic(x.i)}</span><span class="lbl">${x.l}</span>${badge[k]?`<span class="badge${prevBadge[k]!=null&&prevBadge[k]!==badge[k]?" pop":""}">${badge[k]}</span>`:""}</button>`).join("");
 prevBadge=badge; placeInd();
 const rIcon={tech:"wrench",helpdesk:"headset",head:"shield",fm:"building"}[S.role];
 roleBtn.innerHTML=`<span class="ravatar">${ic(rIcon)}</span><span class="rtxt"><small>Viewing as</small>${ROLES[S.role].l}</span>${ic("chev","chev")}`;
 const openN=S.jobs.filter(j=>j.stage!=="complete").length, newN=S.jobs.filter(j=>j.stage==="new").length, llN=badge.landlord||0;
 document.getElementById("hstats").innerHTML=`<span class="hs date">${ic("calendar")}${td.toLocaleDateString("en-IE",{weekday:"short",day:"numeric",month:"short"})}</span>
  <button class="hs" data-act="hstat" data-v="open"><span class="dot st-progress"></span><b>${openN}</b>open</button>
  <button class="hs" data-act="hstat" data-v="new"><span class="dot st-new"></span><b>${newN}</b>new</button>
  <button class="hs" data-act="hstat" data-v="landlord"><span class="dot" style="background:var(--badge)"></span><b>${llN}</b>with landlord</button>`;
 roleBtn.setAttribute("aria-label","Viewing as "+ROLES[S.role].l+". Change role");
 app.innerHTML=VIEWS[v].f();
}
let lastView=null;
window.addEventListener("hashchange",()=>{render();if(lastView!==cur())window.scrollTo(0,0);lastView=cur()});
let rT;window.addEventListener("resize",()=>{placeInd();clearTimeout(rT);rT=setTimeout(()=>{if(cur()==="planned")render()},200)});
load();lastView=cur();render();
getDL().then(n=>{if(!n&&window.claude&&window.claude.use)document.body.classList.add("no-dl")});
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(placeInd);
})();
</script>
</body>
