function seed(){
 const n=Date.now();
 return RAW.map((r,i)=>{
  const created=n-r.age*DAY-(2+i%5)*HOUR;
  const path=["new","assigned"]; if(r.via)path.push("part"); path.push("progress","complete");
  const upto=path.indexOf(r.stage);
  const hist=[];
  for(let k=0;k<=upto;k++){hist.push({s:path[k],at:k===0?created:created+(n-created)*(k/(upto+1))})}
  const s=site(r.site);
  return {id:r.id,title:r.title,site:r.site,loc:r.loc,detail:r.detail,stage:r.stage,ch:r.ch,resp:r.resp,con:r.con,pri:r.pri,part:r.part||null,
