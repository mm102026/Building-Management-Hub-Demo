<!doctype html>
<html lang="en-IE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Building Management Hub</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
[hidden]{display:none!important} body{margin:0}
/* Layout: sticky header with hazard stripe, single content column (max 1240px), fixed bottom tab bar sized for gloved/greasy thumbs; cards in an auto-fill grid. */
:root{
  --bg:#F7F6FF; --surface:#FFFFFF; --surface-2:#F3F2FF; --ink:#1F1A4D; --muted:#5E5A8F; --line:#E3E1F8;
  --brand:#3C3489; --brand-ink:#ffffff; --brand-soft:#EEEDFE; --step:#534AB7; --adv-ink:#ffffff;
  --hazard:#534AB7; --hazard-ink:#ffffff; --lav:#CECBF6; --badge:#d6336c; --tab-a:#6A60D6; --tab-b:#3C3489; --hdr-wash:#ECE9FF; --total-hot:#E8408F; --total-bg1:#FFF2F8; --total-bg2:#FFE0EE; --total-line:#F9C3DB; --w-tech:#0F6E56; --w-tech-bg:#E1F5EE; --w-con:#B05A08; --w-con-bg:#FDEEDC; --w-ll:#C2306E; --w-ll-bg:#FCE4EF; --grid:rgba(83,74,183,.10);
  --danger:#b3261e; --danger-bg:#fbe6e4; --warn:#9a5b00; --warn-bg:#fdf0d9; --ok:#0F6E56;
  --s-new:#2a65a6; --s-new-bg:#e2ecf7;
  --s-assigned:#6847ad; --s-assigned-bg:#ece6f7;
  --s-part:#b05a08; --s-part-bg:#fbeadb;
  --s-progress:#0a7b70; --s-progress-bg:#dcf1ee;
  --s-complete:#2b7a3c; --s-complete-bg:#e1f1e4;
  --c-fire:#c0392b; --c-water:#1f7fa8; --c-lifts:#6847ad; --c-hvac:#0a7b70; --c-elec:#b07a00; --c-fabric:#6b5a48;
  --shadow:0 1px 2px rgba(60,52,137,.05),0 6px 20px rgba(60,52,137,.08);
  --f-display:"Plus Jakarta Sans","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --f-body:"Plus Jakarta Sans","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --tap:56px; --radius:14px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#12102A; --surface:#1B1838; --surface-2:#231F47; --ink:#EEEDFE; --muted:#AFA9EC; --line:#332E66;
  --brand:#3C3489; --brand-ink:#ffffff; --brand-soft:#262256; --step:#9A93EE; --adv-ink:#12102A;
  --hazard:#9A93EE; --hazard-ink:#14112E; --lav:#CECBF6; --badge:#e0457b; --tab-a:#7d72ea; --tab-b:#4a3fb0; --hdr-wash:#241f52; --grid:rgba(154,147,238,.10); --total-hot:#FF7DBE; --total-bg1:#3a1a33; --total-bg2:#2a1228; --total-line:#5c2a4d; --w-tech:#5DCAA5; --w-tech-bg:#0B2E25; --w-con:#F0A35E; --w-con-bg:#36230f; --w-ll:#FF7DBE; --w-ll-bg:#3a1a33;
  --danger:#ff8a80; --danger-bg:#3a1d1b; --warn:#f3b65a; --warn-bg:#352812; --ok:#5DCAA5;
  --s-new:#78aee9; --s-new-bg:#18293b;
  --s-assigned:#ad95ea; --s-assigned-bg:#251e3a;
  --s-part:#eb9a50; --s-part-bg:#36230f;
  --s-progress:#45c6b7; --s-progress-bg:#0f2e2b;
  --s-complete:#6cc47f; --s-complete-bg:#152d1b;
  --c-fire:#ff7b6b; --c-water:#5cb8e0; --c-lifts:#ad95ea; --c-hvac:#45c6b7; --c-elec:#e8b844; --c-fabric:#c4ad93;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 6px 20px rgba(0,0,0,.28);
  color-scheme:dark;
}}
:root[data-theme="dark"]{
  --bg:#12102A; --surface:#1B1838; --surface-2:#231F47; --ink:#EEEDFE; --muted:#AFA9EC; --line:#332E66;
  --brand:#3C3489; --brand-ink:#ffffff; --brand-soft:#262256; --step:#9A93EE; --adv-ink:#12102A;
  --hazard:#9A93EE; --hazard-ink:#14112E; --lav:#CECBF6; --badge:#e0457b; --tab-a:#7d72ea; --tab-b:#4a3fb0; --hdr-wash:#241f52; --grid:rgba(154,147,238,.10); --total-hot:#FF7DBE; --total-bg1:#3a1a33; --total-bg2:#2a1228; --total-line:#5c2a4d; --w-tech:#5DCAA5; --w-tech-bg:#0B2E25; --w-con:#F0A35E; --w-con-bg:#36230f; --w-ll:#FF7DBE; --w-ll-bg:#3a1a33;
  --danger:#ff8a80; --danger-bg:#3a1d1b; --warn:#f3b65a; --warn-bg:#352812; --ok:#5DCAA5;
  --s-new:#78aee9; --s-new-bg:#18293b;
  --s-assigned:#ad95ea; --s-assigned-bg:#251e3a;
  --s-part:#eb9a50; --s-part-bg:#36230f;
  --s-progress:#45c6b7; --s-progress-bg:#0f2e2b;
  --s-complete:#6cc47f; --s-complete-bg:#152d1b;
  --c-fire:#ff7b6b; --c-water:#5cb8e0; --c-lifts:#ad95ea; --c-hvac:#45c6b7; --c-elec:#e8b844; --c-fabric:#c4ad93;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 6px 20px rgba(0,0,0,.28);
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.45;-webkit-tap-highlight-color:transparent;padding-bottom:calc(24px + env(safe-area-inset-bottom,0px))}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--surface)}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
button:focus-visible{outline:3px solid var(--hazard);outline-offset:2px}
.ic{width:1.3em;height:1.3em;flex:none;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.wrap{max-width:1240px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}

/* header */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;color:var(--ink);border-bottom:1px solid var(--line);box-shadow:0 8px 24px rgba(60,52,137,.08);
  background:var(--surface);background:linear-gradient(100deg,color-mix(in srgb,var(--surface) 92%,transparent) 0%,color-mix(in srgb,var(--surface) 92%,transparent) 40%,color-mix(in srgb,var(--hdr-wash) 92%,transparent) 100%);
  -webkit-backdrop-filter:saturate(1.4) blur(14px);backdrop-filter:saturate(1.4) blur(14px)}
.top::before{content:"";position:absolute;inset:0;pointer-events:none;
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:24px 24px;
  -webkit-mask-image:linear-gradient(90deg,transparent 35%,#000 100%);mask-image:linear-gradient(90deg,transparent 35%,#000 100%)}
.top>*{position:relative}
.top-in{display:flex;align-items:center;gap:14px;padding-block:12px}
.logo{width:48px;height:48px;border-radius:15px;background:linear-gradient(140deg,var(--tab-a),var(--tab-b));color:#fff;display:grid;place-items:center;flex:none;
  box-shadow:0 8px 20px rgba(83,74,183,.35),inset 0 1px 0 rgba(255,255,255,.3)}
.logo .ic{width:28px;height:28px}
.homebtn{display:flex;align-items:center;gap:14px;min-width:0;flex:1;text-align:left;padding:4px 8px 4px 4px;margin-left:-4px;border-radius:18px;transition:background .2s}
.homebtn:hover{background:color-mix(in srgb,var(--brand-soft) 70%,transparent)}
.homebtn .logo{transition:transform .25s cubic-bezier(.34,1.5,.5,1)}
.homebtn:hover .logo{transform:rotate(-6deg) scale(1.05)}
.homebtn:active .logo{transform:scale(.94)}
.brandname{min-width:0;flex:1;display:grid;gap:5px}
.brandname h1{margin:0;font-family:var(--f-display);font-weight:800;font-size:1.35rem;letter-spacing:-.02em;line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brandname h1 span{background:linear-gradient(120deg,var(--tab-a),var(--badge));-webkit-background-clip:text;background-clip:text;color:transparent}
.brandname p{margin:0;display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:.74rem;font-weight:700}
.hpill{padding:2px 8px;border-radius:999px;background:var(--brand-soft);color:var(--hazard);letter-spacing:.06em;text-transform:uppercase;font-size:.66rem;font-weight:800;border:1px solid var(--line)}
.hpill.alpha{background:linear-gradient(120deg,var(--tab-a),var(--tab-b));color:#fff;border-color:transparent}
.hmeta{color:var(--muted);font-weight:600}
.hstats{display:flex;gap:8px;align-items:center}
.hs{display:flex;align-items:center;gap:8px;min-height:48px;padding:0 14px;border-radius:14px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);font-size:.85rem;color:var(--muted);font-weight:600;transition:transform .15s,box-shadow .2s}
.hs:hover{transform:translateY(-2px)}
.hs b{font-size:1.15rem;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.hs .dot{width:10px;height:10px}
.hs.date{background:transparent;box-shadow:none;border-style:dashed}
.hs.date .ic{color:var(--hazard)}
.rolebtn{display:flex;align-items:center;gap:10px;min-height:52px;padding:4px 12px 4px 4px;border-radius:999px;background:var(--surface);color:var(--ink);font-weight:700;border:1px solid var(--line);box-shadow:var(--shadow);transition:box-shadow .2s}
.rolebtn:hover{box-shadow:0 8px 22px rgba(83,74,183,.22)}
.ravatar{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(140deg,var(--tab-a),var(--tab-b));position:relative}
.ravatar::after{content:"";position:absolute;right:1px;bottom:1px;width:11px;height:11px;border-radius:50%;background:#2fbf71;box-shadow:0 0 0 2px var(--surface)}
.rolebtn small{display:block;font-size:.64rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.rolebtn span.rtxt{text-align:left;line-height:1.2}
.rolebtn .chev{color:var(--muted);width:18px;height:18px}
.stripe{display:none}
@media (max-width:1180px){.hs.date{display:none}}
@media (max-width:980px){.hstats{display:none}}
@media (max-width:560px){.rolebtn .rtxt,.rolebtn .chev{display:none}.rolebtn{padding:4px}.brandname h1{font-size:1.08rem}.hmeta{display:none}.logo{width:40px;height:40px;border-radius:12px}.logo .ic{width:24px;height:24px}}

/* top nav (sticky with header): pill track with a sliding active indicator */
.tabs{border-top:1px solid var(--line);padding-block:10px}
.tab-track{position:relative;background:var(--surface-2);border:1px solid var(--line);border-radius:20px;padding:6px;box-shadow:inset 0 1px 3px rgba(60,52,137,.08)}
.tabs-in{position:relative;z-index:1;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}
.tab-ind{position:absolute;z-index:0;top:6px;bottom:6px;left:0;width:0;border-radius:15px;background:linear-gradient(135deg,var(--tab-a),var(--tab-b));box-shadow:0 8px 22px rgba(83,74,183,.38),inset 0 1px 0 rgba(255,255,255,.25);opacity:0}
.tab-ind.ready{opacity:1}
.tab-ind.anim{transition:transform .38s cubic-bezier(.34,1.3,.5,1),width .38s cubic-bezier(.34,1.3,.5,1)}
.tab{position:relative;min-height:64px;border-radius:15px;display:flex;align-items:center;justify-content:center;gap:10px;color:var(--muted);font-weight:700;font-size:1rem;transition:color .2s,transform .15s,background .2s}
.tab .tic{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:var(--brand-soft);color:var(--hazard);transition:background .2s,color .2s,transform .25s}
.tab .ic{width:24px;height:24px}
.tab:hover{color:var(--ink);background:var(--surface)}
.tab:hover .tic{transform:translateY(-2px) rotate(-4deg)}
.tab:active{transform:scale(.96)}
.tab[aria-current="page"]{color:#fff;background:transparent}
.tab[aria-current="page"] .tic{background:rgba(255,255,255,.2);color:#fff}
.tab[aria-current="page"] .lbl{letter-spacing:.01em}
.tab .badge{min-width:24px;height:24px;border-radius:12px;background:var(--badge);color:#fff;font-weight:800;font-size:.78rem;display:grid;place-items:center;padding:0 7px;font-variant-numeric:tabular-nums;box-shadow:0 0 0 2px var(--surface-2),0 3px 8px rgba(214,51,108,.4)}
.tab[aria-current="page"] .badge{box-shadow:0 0 0 2px #fff,0 3px 8px rgba(0,0,0,.2)}
.badge.pop{animation:pop .5s cubic-bezier(.34,1.6,.5,1)}
@keyframes pop{0%{transform:scale(.4)}100%{transform:scale(1)}}
@media (max-width:900px){.tab{flex-direction:column;gap:4px;font-size:.8rem;min-height:72px;padding:4px 2px}.tab .tic{width:34px;height:30px;border-radius:10px}.tab .badge{position:absolute;top:2px;right:4px;min-width:20px;height:20px;font-size:.7rem;padding:0 5px}}
@media (max-width:640px){.tabs{padding-block:8px}.tab-track{padding:4px;border-radius:16px}.tab-ind{top:4px;bottom:4px;border-radius:12px}.tabs-in{gap:2px}.tab{font-size:.7rem;border-radius:12px}.tab .tic{background:transparent}.top-in{padding-block:10px}}
@media (prefers-reduced-motion:reduce){.tab-ind.anim,.tab,.tab .tic{transition:none}.badge.pop{animation:none}}

/* generic */
main{padding-block:18px 24px;display:grid;gap:18px}
.vhead{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:12px}
.vhead h2{margin:0;font-family:var(--f-display);font-weight:800;font-size:1.8rem;line-height:1.1;letter-spacing:-.02em;text-wrap:balance}
.vhead p{margin:4px 0 0;color:var(--muted);max-width:60ch}
.eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.sample{display:inline-flex;align-items:center;gap:6px;font-family:var(--f-mono);font-size:.72rem;letter-spacing:.04em;text-transform:uppercase;padding:3px 8px;border-radius:4px;background:var(--warn-bg);color:var(--warn);border:1px dashed currentColor}
.seg-ctrl{display:inline-flex;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:4px;gap:4px}
.seg-ctrl button{min-height:52px;padding:0 18px;border-radius:9px;font-weight:600;display:flex;align-items:center;gap:8px;color:var(--muted)}
.seg-ctrl button[aria-pressed="true"]{background:var(--brand);color:var(--brand-ink)}
.btn{min-height:var(--tap);padding:0 18px;border-radius:var(--radius);font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:1rem}
.btn-ghost{background:var(--surface);border:1.5px solid var(--line)}
.btn-brand{background:var(--brand);color:var(--brand-ink)}
.btn-hazard{background:var(--hazard);color:var(--hazard-ink);box-shadow:0 6px 18px rgba(83,74,183,.28)}
.btn-danger{background:var(--danger);color:#fff}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.scroller{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin}
.scroller>*{flex:none}
.chip{min-height:48px;padding:0 16px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);font-weight:600;display:inline-flex;align-items:center;gap:8px;font-size:.95rem}
.chip[aria-pressed="true"]{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
.chip .n{font-family:var(--f-mono);font-size:.8rem;opacity:.75}
.schip{color:var(--sc);border-color:var(--sc)}
.schip[aria-pressed="true"]{background:var(--sc);border-color:var(--sc);color:var(--adv-ink)}
.chip.rm::after{content:"✕";font-size:.8rem;opacity:.8}
.empty{padding:32px 20px;text-align:center;color:var(--muted);background:var(--surface);border:1.5px dashed var(--line);border-radius:var(--radius)}

/* stage tiles */
.tiles{display:grid;grid-template-columns:minmax(0,1.5fr) repeat(5,minmax(0,1fr));gap:10px;align-items:stretch}
@media (max-width:900px){.tiles{display:flex;overflow-x:auto;padding:4px 2px 8px}.tiles>*{flex:0 0 132px}.tiles>.total{flex-basis:190px}}
.tiles .tile.total{position:relative;overflow:hidden;color:var(--total-hot);border:1.5px solid var(--total-line);background:linear-gradient(140deg,var(--total-bg1),var(--total-bg2));box-shadow:0 10px 26px rgba(232,64,143,.22);gap:4px;justify-content:flex-start;padding:14px 16px}
.tiles .tile.total::after{content:"";position:absolute;right:-30px;top:-30px;width:120px;height:120px;border-radius:50%;background:rgba(232,64,143,.07)}
.tiles .tile.total b,.tiles .tile.total .tl-top,.tiles .tile.total .tl-sub{color:var(--total-hot);font-weight:800;text-shadow:0 0 14px rgba(232,64,143,.35)}
.tiles .tile.total b{font-size:3.3rem}
.tiles .tile.total .tl-top{display:flex;align-items:center;gap:6px;font-size:1rem;text-transform:uppercase;letter-spacing:.06em}
.tiles .tile.total .tl-sub{font-size:1.05rem}
.tiles .tile.total .tl-bar{display:block;height:9px;border-radius:5px;background:rgba(232,64,143,.18);margin-top:4px;overflow:hidden}
.tiles .tile.total .tl-bar i{display:block;height:100%;background:var(--total-hot);border-radius:5px;box-shadow:0 0 10px rgba(232,64,143,.6)}
.tiles .tile.total[aria-pressed="false"]{box-shadow:none}
.tile{min-height:92px;border-radius:var(--radius);background:var(--surface);border:2px solid transparent;box-shadow:var(--shadow);padding:12px 14px;display:flex;flex-direction:column;justify-content:space-between;text-align:left;color:var(--sc)}
.tile b{font-family:var(--f-display);font-weight:800;font-size:1.9rem;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums;color:var(--ink)}
.tile span{display:flex;align-items:center;gap:6px;font-weight:700;font-size:.9rem}
.tile[aria-pressed="true"]{border-color:var(--sc);background:var(--sbg)}
.st-new{--sc:var(--s-new);--sbg:var(--s-new-bg)}
.st-assigned{--sc:var(--s-assigned);--sbg:var(--s-assigned-bg)}
.st-part{--sc:var(--s-part);--sbg:var(--s-part-bg)}
.st-progress{--sc:var(--s-progress);--sbg:var(--s-progress-bg)}
.st-complete{--sc:var(--s-complete);--sbg:var(--s-complete-bg)}

/* toolbar */
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.toolbar .grow{flex:1}
.btn-filter{min-height:60px;padding:0 22px;font-size:1.05rem;color:#fff;background:linear-gradient(140deg,var(--tab-a),var(--tab-b));box-shadow:0 8px 20px rgba(83,74,183,.32);transition:transform .15s,box-shadow .2s}
.btn-filter:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(83,74,183,.4)}
.btn-filter .ic{width:24px;height:24px}
.btn-filter .fcount{background:var(--badge);color:#fff;box-shadow:0 0 0 2px rgba(255,255,255,.9)}
.btn-sort{min-height:60px;padding:0 20px;font-size:1.05rem;background:var(--brand-soft);color:var(--hazard);border:2px solid var(--hazard);transition:transform .15s,background .2s}
.btn-sort:hover{transform:translateY(-2px);background:var(--surface)}
.btn-sort .ic{width:24px;height:24px}
.btn-filter:active,.btn-sort:active{transform:scale(.97)}
.fcount{background:var(--hazard);color:var(--hazard-ink);border-radius:999px;min-width:24px;height:24px;font-size:.8rem;display:grid;place-items:center;padding:0 6px}

/* site bar */
.sitesec{display:grid;gap:8px}
.sitesec .crew-h{flex-wrap:wrap}
.sitesec .crew-h .scroller{gap:6px;max-width:100%}
.cchip{min-height:44px;padding:0 14px;font-size:.88rem}
.cchip .ic{width:16px;height:16px}
.sitebar{padding:2px 2px 6px}
.sitebtn{display:flex;align-items:center;gap:10px;min-height:66px;padding:8px 12px 8px 8px;border-radius:16px;background:var(--surface);border:1.5px solid var(--line);box-shadow:var(--shadow);text-align:left;transition:transform .15s,border-color .2s}
.sitebtn:hover{transform:translateY(-2px);border-color:var(--hazard)}
.sitebtn .sbic{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:var(--brand-soft);color:var(--hazard);flex:none}
.sitebtn .sbic .ic{width:24px;height:24px}
.sitebtn .sbt{display:grid;line-height:1.2}
.sitebtn .sbt b{font-weight:800;white-space:nowrap}
.sitebtn .sbt small{color:var(--muted);font-weight:600;font-size:.8rem}
.sitebtn .sbn{min-width:30px;height:30px;padding:0 8px;border-radius:15px;display:grid;place-items:center;background:var(--brand-soft);color:var(--hazard);font-weight:800;font-variant-numeric:tabular-nums}
.sitebtn[aria-pressed="true"]{background:linear-gradient(140deg,var(--tab-a),var(--tab-b));border-color:transparent;color:#fff;box-shadow:0 8px 22px rgba(83,74,183,.35)}
.sitebtn[aria-pressed="true"] .sbic,.sitebtn[aria-pressed="true"] .sbn{background:rgba(255,255,255,.2);color:#fff}
.sitebtn[aria-pressed="true"] .sbt small{color:rgba(255,255,255,.85)}

/* pipeline status row */
