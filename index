  if(!ignoreStage&&f.stage.length&&!f.stage.includes(j.stage))return false;
  if(f.con.length&&!f.con.some(c=>c==="yes"?!!j.con:c==="no"?!j.con:j.con===c))return false;
  if(f.county.length&&!f.county.includes(site(j.site).county))return false;
  if(f.site.length&&!f.site.includes(j.site))return false;
  if(f.fm.length&&!f.fm.includes(j.fm))return false;
  if(f.ch.length&&!f.ch.includes(j.ch))return false;
  if(f.tech.length&&!f.tech.includes(j.tech))return false;
