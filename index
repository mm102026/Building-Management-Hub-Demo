function ppmFor(y,m){ // m 0-11
 const k=y+"-"+m; if(calCache[k])return calCache[k];
 const out=[];
 PPM.forEach(p=>{
  if(!p.m.includes(m+1))return; if(p.years&&!p.years.includes(y))return;
  SITES.forEach((s,si)=>{
   if(p.sites&&!p.sites.includes(s.id))return;
   let day=p.d+(p.stagger?si*2:si%3); const dim=new Date(y,m+1,0).getDate(); if(day>dim)day=dim-((day-dim)%5);
   let dt=new Date(y,m,day); const w=dt.getDay(); if(w===6)dt=new Date(y,m,day+2>dim?day-1:day+2); if(w===0)dt=new Date(y,m,day+1>dim?day-2:day+1);
