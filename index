   ll:r.ll?{cat:r.ll.cat,clause:r.ll.clause,agentRef:r.ll.agentRef,status:r.ll.status,reported:created+HOUR,chases:r.ll.chases.map(d=>n-d*DAY)}:null};
 });
}

