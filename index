async function saveCSV(filename,text){
 const dlNS=await getDL();
 if(dlNS){
  try{await dlNS.save({filename,data:text});return"saved"}
  catch(e){return e&&e.code==="declined"?"declined":"failed"}
 }
 if(window.claude&&window.claude.use)return"failed";
 try{const url=URL.createObjectURL(new Blob([text],{type:"text/csv;charset=utf-8"}));const a=document.createElement("a");a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);return"saved"}catch(e){return"failed"}
}
