   saveCSV(fn,toCSV(r.rows())).then(st=>toast(st==="saved"?"Saved "+fn:st==="declined"?"Download cancelled":"Download isn't available in this view. Open the standalone file to export."));break}
  case"countyGo":S.f.county=v==="All"?[]:[v];S.f.site=S.f.site.filter(id=>v==="All"||site(id).county===v);save();render();break;
  case"siteGo":S.f.site=v==="All"?[]:[v];save();render();break;
